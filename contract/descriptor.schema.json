{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alfthrpy/sdsim/contract/descriptor.schema.json",
  "title": "Catalog entry descriptor (component, policy, scenario)",
  "description": "What a component, edge policy or scenario injector declares about itself. The catalog and the lab-spec checks C03/C04 are generated from these (ADR 0003 #1). Checked at build time, not here: min greater than max, a default outside [min, max] or outside an enum's values, duplicate parameter or metric ids, and an evidence id without a matching test. The $id is an identifier, not a fetched address.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "component"
        },
        "id": {
          "$ref": "lab-spec.schema.json#/$defs/kebab"
        },
        "label_key": {
          "$ref": "#/$defs/label"
        },
        "description_key": {
          "$ref": "#/$defs/label"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "honesty": {
          "$ref": "#/$defs/honesty"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      },
      "required": ["kind", "id", "label_key", "parameters", "metrics", "honesty"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "policy"
        },
        "id": {
          "$ref": "lab-spec.schema.json#/$defs/kebab"
        },
        "label_key": {
          "$ref": "#/$defs/label"
        },
        "description_key": {
          "$ref": "#/$defs/label"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "honesty": {
          "$ref": "#/$defs/honesty"
        }
      },
      "required": ["kind", "id", "label_key", "parameters", "honesty"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "scenario"
        },
        "id": {
          "$ref": "lab-spec.schema.json#/$defs/kebab"
        },
        "label_key": {
          "$ref": "#/$defs/label"
        },
        "description_key": {
          "$ref": "#/$defs/label"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "honesty": {
          "$ref": "#/$defs/honesty"
        }
      },
      "required": ["kind", "id", "label_key", "parameters", "honesty"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$"
    },
    "evidence": {
      "type": "string",
      "pattern": "^V(1|3|4|10)\\.[a-z0-9][a-z0-9.-]*$"
    },
    "assumption": {
      "type": "string",
      "pattern": "^A-[A-Z][0-9]+$"
    },
    "unit": {
      "enum": ["fraction", "ms", "s", "rps", "count", "percent", "none"]
    },
    "honesty": {
      "type": "object",
      "properties": {
        "label": {
          "enum": ["modeled", "illustrative", "not-modeled"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "assumption": {
          "$ref": "#/$defs/assumption"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "lab-spec.schema.json#/$defs/kebab"
          }
        }
      },
      "required": ["label"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "modeled"
              }
            },
            "required": ["label"]
          },
          "then": {
            "required": ["evidence"],
            "properties": {
              "evidence": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "illustrative"
              }
            },
            "required": ["label"]
          },
          "then": {
            "required": ["assumption"],
            "properties": {
              "assumption": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "not-modeled"
              }
            },
            "required": ["label"]
          },
          "then": {
            "properties": {
              "evidence": false,
              "assumption": false
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label_key": {
          "$ref": "#/$defs/label"
        },
        "kind": {
          "enum": ["number", "integer", "enum", "boolean"]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "default": {
          "type": ["number", "string", "boolean"]
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "label_key", "kind", "unit", "default"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["number", "integer"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["min", "max"],
            "properties": {
              "min": true,
              "max": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["values"],
            "properties": {
              "default": {
                "type": "string"
              },
              "min": false,
              "max": false,
              "values": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              },
              "min": false,
              "max": false,
              "values": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              },
              "values": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "integer"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "integer"
              },
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "values": false
            }
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label_key": {
          "$ref": "#/$defs/label"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "aggregates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["mean", "max", "p99"]
          }
        }
      },
      "required": ["id", "label_key", "unit", "aggregates"],
      "additionalProperties": false
    }
  }
}
